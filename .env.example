# ═══════════════════════════════════════════════════════════════════════
#  DATABASE — SUPABASE KEYS GO HERE
#
#  Right now these two lines point to the LOCAL test database on this computer.
#  To use Supabase:
#    1. Open https://supabase.com/dashboard/project/yckdgfeznlzoawlqmgbd
#    2. Click "Connect" (top of the page) → "ORMs" tab → "Prisma"
#    3. Copy the DATABASE_URL line and the DIRECT_URL line it shows
#    4. Paste them below, REPLACING the two lines that start with DATABASE_URL= and DIRECT_URL=
#    5. In both lines, replace [YOUR-PASSWORD] with your Supabase database password
#       (forgot it? Supabase → Project Settings → Database → Reset database password)
#    6. Save this file, then run:  npm run supabase:setup
#  The "publishable key" (sb_publishable_...) is NOT needed anywhere.
# ═══════════════════════════════════════════════════════════════════════
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54329/postgres?sslmode=disable&connection_limit=1&pgbouncer=true"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54329/postgres?sslmode=disable&connection_limit=1"

# Random 32+ char string. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# Public URL of the site
APP_URL="http://localhost:3000"

# WhatsApp support number, international format without + (e.g. 15551234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=""

NEXT_PUBLIC_SITE_NAME="Casino Players Club"
# Bonuses, coin pricing, promotions and per-game RTP are edited in /admin/settings

# Keep these OFF until you hold a gaming license and your payment providers approve gaming use.
PAYMENTS_ENABLED=false
WITHDRAWALS_ENABLED=false
